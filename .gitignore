# Browser scraping (fetch.mjs): il profilo contiene i TUOI cookie di sessione
# e le pagine sono HTML grezzo da centinaia di KB. Niente di tutto cio' va nel repo.
apps/scraper/browser/.profile/
apps/scraper/browser/pages/

# Log del crawl (crawl.command)
logs/
# ...tranne il riepilogo dell'ultimo crawl: e' il modo in cui il risultato
# arriva a chi non era davanti allo schermo (me compreso, quando me lo chiedi).
!logs/ultimo-crawl.txt
apps/scraper/browser/blocked/
apps/scraper/browser/.chrome-profile/

# Canale notifiche: e' un nome segreto, chi lo conosce riceve i tuoi avvisi.
notify.conf
logs/.inizio-giro
